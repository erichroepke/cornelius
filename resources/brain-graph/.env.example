# Copy this file to `.env` and edit. `.env` is gitignored.
#
# Generate a strong password:
#   openssl rand -base64 24
#
# This file is loaded by:
#   - docker-compose.neo4j.yml (via env_file)
#   - load_neo4j.sh (via source)
#   - any future scripts that talk to the Neo4j container

# Neo4j authentication
# NOTE: keys use BRAIN_ prefix so they don't collide with Neo4j's auto-translation
# of NEO4J_* env vars into neo4j.conf settings (a known Neo4j 5.x strict-mode gotcha).
BRAIN_NEO4J_USER=neo4j
BRAIN_NEO4J_PASS=changeme-rotate-this-now

# Optional: override default Bolt URI (used by Python clients if/when added)
# BRAIN_NEO4J_URI=bolt://localhost:7687
